NODE_ENV=development
PORT=3000
LOG_LEVEL=info
POSTGRES_HOST_PORT=15432
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:15432/reservation_system
JWT_SECRET=change-me-in-local-development
JWT_ISSUER=reservation-system
JWT_AUDIENCE=reservation-system-client
JWT_EXPIRES_IN_SECONDS=3600
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=1000
PG_STATEMENT_TIMEOUT_MS=3000
PG_IDLE_IN_TX_TIMEOUT_MS=4000
PG_TRANSACTION_TIMEOUT_MS=5000
PG_IDEMPOTENCY_LOCK_TIMEOUT_MS=300
PG_SEAT_LOCK_TIMEOUT_MS=500
RESERVATION_MAX_SEATS=8
RESERVATION_TX_RETRY_ATTEMPTS=2
